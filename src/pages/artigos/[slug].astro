---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { slugFor } from '../../data/site';
export async function getStaticPaths(){const posts=await getCollection('blog', ({data})=>!data.draft); return posts.map(post=>({params:{slug:post.id},props:{post}}));}
const {post}=Astro.props; const {Content}=await render(post); const d=post.data;
const all=(await getCollection('blog',({data})=>!data.draft)).filter(p=>p.id!==post.id).slice(0,2);
const pageUrl=new URL(`/artigos/${post.id}/`, Astro.site).toString();
const schema={'@context':'https://schema.org','@type':'BlogPosting',headline:d.title,description:d.description,mainEntityOfPage:pageUrl,image:new URL(d.image,Astro.site).toString(),datePublished:d.date.toISOString(),dateModified:(d.updated||d.date).toISOString(),author:{'@type':'Organization',name:d.author},publisher:{'@type':'Organization',name:'Carro Certo'},inLanguage:'pt-BR'};
---
<Base title={d.title} description={d.description} image={d.image} type="article" published={d.date.toISOString()} updated={(d.updated||d.date).toISOString()}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}/>
  <div class="shell breadcrumb"><a href="/">Início</a><span>›</span><a href={`/categoria/${slugFor(d.category)}/`}>{d.category}</a><span>›</span><span>Artigo</span></div>
  <div class="shell article-layout"><article class="article-main"><a class="eyebrow" href={`/categoria/${slugFor(d.category)}/`}>{d.category}</a><h1>{d.title}</h1><p class="article-deck">{d.description}</p><div class="article-author"><span class="avatar">CC</span><div><strong>{d.author}</strong><span><time datetime={d.date.toISOString()}>{d.date.toLocaleDateString('pt-BR',{day:'2-digit',month:'long',year:'numeric'})}</time> • {d.readingTime} min de leitura</span></div></div><img class="article-cover" src={d.image} alt={d.imageAlt} width="1000" height="580"/><div class="article-content"><Content/></div><div class="source-note"><strong>Compromisso editorial</strong><p>Informações técnicas e valores de mercado podem mudar. Antes de comprar, confira dados oficiais e avaliações verificáveis. Relatos externos devem ter atribuição e contexto.</p></div><div class="article-tags">{d.tags.map(tag=><span>#{tag}</span>)}</div></article><aside class="article-aside"><div class="aside-panel"><span class="kicker">CARRO CERTO</span><h3>Informação que move.</h3><p>Análises práticas, sem exageros, para pesquisar antes de comprar.</p><a href="/categoria/guias/">Explore os guias ↗</a></div><div class="ad-slot" data-adsterra-slot="sidebar"><small>ESPAÇO PUBLICITÁRIO</small><p>Anúncio disponível após configuração.</p></div></aside></div>
  {all.length>0 && <section class="shell section"><div class="section-heading"><div><span class="kicker">CONTINUE LENDO</span><h2>Outras matérias</h2></div></div><div class="posts-grid">{all.map(p=><PostCard post={p}/>)}</div></section>}
</Base>
